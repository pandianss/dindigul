{
    "compilerOptions": {
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "scratch",
        "src/__tests__",
        "src/generated",
        "src/scratch",
        "src/scripts",
        "src/tools",
        "src/check_*.ts",
        "src/find_chief.ts",
        "src/list_users.ts",
        "src/seed*.ts"
  ]
}
