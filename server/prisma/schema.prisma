datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  fullNameEn   String
  fullNameTa   String?
  fullNameHi   String?
  grade        String?
  role         String   @default("BRANCH_USER") // ADMIN, RO_MANAGER, SECTION_USER, BRANCH_USER
  photo        Photo?   @relation(fields: [photoId], references: [id])
  photoId      String?
  section      String?  // The specific section (e.g., "Accounts", "Planning", "IT", "HR")
  
  branch       Branch?  @relation("BranchMembers", fields: [branchId], references: [id])
  branchId     String?
  
  // Leadership roles
  isRegionHead     Boolean @default(false)
  isSecondLine     Boolean @default(false)
  headedBranch     Branch? @relation("BranchHead")
  secondLineBranch Branch? @relation("BranchSecondLine")

  departmentId     String?
  department       Department? @relation("UserDepartment", fields: [departmentId], references: [id])
  departments      Department[] @relation("UserDepartments")
  managedDepartments Department[] @relation("DepartmentHeads")

  designation      Designation? @relation(fields: [designationId], references: [id])
  designationId    String?
  
  preparedNotes    OfficeNote[] @relation("NotePreparer")
  approvedNotes    OfficeNote[] @relation("NoteApprover")
  requests         BranchRequest[]
  comments         Comment[]
  actionPoints     ActionPoint[]
  postingHistory   PostingHistory[]
  
  // Chat relations
  chatMemberships  ChatMember[]
  createdChatGroups ChatGroup[]
  messagesSent     ChatMessage[]
  messageAcks      MessageAck[]
  noticeAcks       NoticeAck[]
  committeeMemberships CommitteeMember[]
  notifications    Notification[]
  // claims           Claim[]
  auditLogs        ChatAuditLog[]

  // GAP 05: Brute-force lockout
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?

  // GAP 04: MFA (TOTP)
  mfaEnabled   Boolean @default(false)
  mfaSecret    String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}

model Committee {
  id        String    @id @default(uuid())
  nameEn    String
  code      String    @unique
  frequency String    @default("MONTHLY")
  meetings  Meeting[]
  members   CommitteeMember[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("committees")
}

model CommitteeMember {
  id          String    @id @default(uuid())
  committee   Committee @relation(fields: [committeeId], references: [id])
  committeeId String
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  role        String    @default("MEMBER") // CHAIRPERSON, CONVENOR, MEMBER
  joinedAt    DateTime  @default(now())

  @@unique([committeeId, userId])
  @@map("committee_members")
}

model Meeting {
  id           String        @id @default(uuid())
  committee    Committee     @relation(fields: [committeeId], references: [id])
  committeeId  String
  date         DateTime
  venue        String        @default("Conference Room")
  status       String        @default("DRAFT")
  minutesJson  String?
  actionPoints ActionPoint[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("meetings")
}

model ActionPoint {
  id               String   @id @default(uuid())
  meeting          Meeting  @relation(fields: [meetingId], references: [id])
  meetingId        String
  content          String
  dueDate          DateTime?
  status           String   @default("PENDING")
  assignedTo       User?    @relation(fields: [assignedToUserId], references: [id])
  assignedToUserId String?
  completionDate   DateTime?
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("action_points")
}

model Branch {
  id                String   @id @default(uuid())
  sNo               Int?
  code              String   @unique
  officeId          Int?
  nameEn            String
  nameTa            String?
  nameHi            String?
  type              String
  openDate          String?
  district          String?
  populationGroup   String?
  riskCategory      String?
  riskEffectiveDate DateTime?
  specialStatus     String?
  ifsc              String?
  address           String?
  latitude          Float?
  longitude         Float?
  pincode           String?

  // Leadership
  headUser          User?    @relation("BranchHead", fields: [headUserId], references: [id])
  headUserId        String?  @unique
  secondLineUser    User?    @relation("BranchSecondLine", fields: [secondLineUserId], references: [id])
  secondLineUserId  String?  @unique

  users             User[]   @relation("BranchMembers")
  
  snapshots         Snapshot[]
  notices           Notice[]
  letters           Letter[]
  requests          BranchRequest[]
  stationeryMovements StationeryMovement[]
  recoveryActions     RecoveryAction[]
  auditObservations   AuditObservation[]
  regionalAssets      RegionalAsset[]
  history             BranchHistory[]
  postingHistory      PostingHistory[]
  atms                Atm[]
  ingestionLogs       IngestionLog[]
  facts               Fact[]
  misSnapshots        MisSnapshot[]
  misExceptions       MisException[]
  noticeAcks          NoticeAck[]
  accountOpenings    AccountOpening[]
  accountClosures    AccountClosure[]
  budgets            BudgetMaster[]
  // campaignTargets     CampaignTarget[]
  // campaignPerformances CampaignPerformance[]
  // periodicReturns     PeriodicReturn[]
  // claims              Claim[]
  // achievements        Achievement[]

  @@map("branches")
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  nameEn    String
  nameTa    String?
  nameHi    String?
  users     User[]   @relation("UserDepartments")
  mainUsers User[]   @relation("UserDepartment")
  heads     User[]   @relation("DepartmentHeads")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model Designation {
  id        String   @id @default(uuid())
  code      String   @unique
  nameEn    String
  nameTa    String?
  nameHi    String?
  workId    Int?
  users     User[]
  postingHistory PostingHistory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("designations")
}

model BranchHistory {
  id           String   @id @default(uuid())
  branch       Branch   @relation(fields: [branchId], references: [id])
  branchId     String
  fieldChanged String
  oldValue     String?
  newValue     String?
  changedBy    String
  changedAt    DateTime @default(now())

  @@map("branch_history")
}

model Letter {
  id           String   @id @default(uuid())
  type         String
  status       String   @default("DRAFT")
  titleEn     String
  contentEn    String
  titleTa      String?
  contentTa    String?
  branch       Branch   @relation(fields: [branchId], references: [id])
  branchId     String
  parameter    Parameter? @relation(fields: [parameterId], references: [id])
  parameterId  String?
  valueAtTime  Float?
  budgetAtTime Float?
  period       String?
  version      Int      @default(1)
  previousVersion   Letter?  @relation("LetterHistory", fields: [previousVersionId], references: [id])
  previousVersionId String?
  nextVersions      Letter[] @relation("LetterHistory")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("letters")
}

model OfficeNote {
  id          String   @id @default(uuid())
  type        String
  status      String   @default("DRAFT")
  titleEn     String
  contentJson String
  preparer    User     @relation("NotePreparer", fields: [preparerId], references: [id])
  preparerId  String
  approver      User?    @relation("NoteApprover", fields: [approverId], references: [id])
  approverId    String?
  version       Int      @default(1)
  previousVersion   OfficeNote? @relation("NoteHistory", fields: [previousVersionId], references: [id])
  previousVersionId String?
  nextVersions      OfficeNote[] @relation("NoteHistory")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("office_notes")
}

model BranchRequest {
  id               String   @id @default(uuid())
  titleEn          String
  contentEn        String
  category         String
  status           String   @default("OPEN")
  priority         String   @default("MEDIUM")
  branch           Branch   @relation(fields: [branchId], references: [id])
  branchId         String
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  assignedSection  String?
  resolutionNotes  String?
  comments         Comment[]
  dueAt            DateTime?
  slaBreached      Boolean  @default(false)
  resolvedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("branch_requests")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  request   BranchRequest @relation(fields: [requestId], references: [id])
  requestId String
  createdAt DateTime @default(now())

  @@map("comments")
}

model Photo {
  id          String   @id @default(uuid())
  photoUrl    String
  checksum    String?
  aspectRatio String   @default("4:5")
  createdAt   DateTime @default(now())
  User        User[]

  @@map("photos")
}

model Holiday {
  id          String   @id @default(uuid())
  date        DateTime @unique
  nameEn      String
  nameTa      String?
  nameHi      String?
  type        String
  description String?
  createdAt   DateTime @default(now())

  @@map("holidays")
}

model Parameter {
  id          String   @id @default(uuid())
  code        String   @unique
  nameEn      String
  nameTa      String?
  nameHi      String?
  category    String
  unit        String   @default("Cr")
  snapshots   Snapshot[]
  letters     Letter[]

  @@map("parameters")
}

model Snapshot {
  id          String   @id @default(uuid())
  date        DateTime
  parameter   Parameter @relation(fields: [parameterId], references: [id])
  parameterId String
  branch      Branch?   @relation(fields: [branchId], references: [id])
  branchId    String?
  value       Float
  budget      Float?
  status      String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@map("snapshots")
}

model Notice {
  id          String   @id @default(uuid())
  titleEn     String
  titleTa     String?
  contentEn   String
  contentTa   String?
  category    String
  priority    String   @default("NORMAL")
  isPinned    Boolean  @default(false)
  branch      Branch?  @relation(fields: [branchId], references: [id])
  branchId    String?
  targetRole  String?
  requiresAck Boolean  @default(false)
  acknowledgements NoticeAck[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notices")
}

model NoticeAck {
  id        String   @id @default(uuid())
  notice    Notice   @relation(fields: [noticeId], references: [id])
  noticeId  String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  branch    Branch   @relation(fields: [branchId], references: [id])
  branchId  String
  createdAt DateTime @default(now())

  @@unique([noticeId, userId])
  @@map("notice_acknowledgements")
}

model DispatchRecord {
  id            String   @id @default(uuid())
  type          String
  subject       String
  sender        String
  recipient     String
  referenceNo   String?
  consignmentNo String?
  status        String   @default("PENDING")
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("dispatch_records")
}

model StationeryItem {
  id         String               @id @default(uuid())
  nameEn     String               @unique
  stockLevel Int                  @default(0)
  movements  StationeryMovement[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@map("stationery_items")
}

model StationeryMovement {
  id        String         @id @default(uuid())
  item      StationeryItem @relation(fields: [itemId], references: [id])
  itemId    String
  branch    Branch?        @relation(fields: [branchId], references: [id])
  branchId  String?
  quantity  Int
  type      String
  date      DateTime       @default(now())
  remarks   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("stationery_movements")
}

model Budget {
  id               String            @id @default(uuid())
  section          String
  financialYear    String
  allocationAmount Float
  spentAmount      Float             @default(0)
  sanctions        ExpenseSanction[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([section, financialYear])
  @@map("budgets")
}

model ExpenseSanction {
  id           String   @id @default(uuid())
  title        String
  sanctionDate DateTime @default(now())
  amount       Float
  section      String
  vendorName   String?
  billNo       String?
  status       String   @default("APPROVED")
  type         String   @default("REVENUE")
  budget       Budget   @relation(fields: [budgetId], references: [id])
  budgetId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("expense_sanctions")
}

model LegalCase {
  id               String   @id @default(uuid())
  caseNo           String   @unique
  courtName        String
  parties          String
  nextHearingDate  DateTime?
  advocateName     String?
  status           String   @default("PENDING")
  category         String   @default("CIVIL")
  hearingHistory   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("legal_cases")
}

model RecoveryAction {
  id             String   @id @default(uuid())
  accountName    String
  amountInvolved Float
  type           String
  status         String   @default("NOTIFIED")
  branch         Branch   @relation(fields: [branchId], references: [id])
  branchId       String
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("recovery_actions")
}

model AuditObservation {
  id                   String   @id @default(uuid())
  auditType            String
  observation          String
  riskLevel            String   @default("MEDIUM")
  status               String   @default("PENDING")
  rectificationDetails String?
  targetDate           DateTime
  auditDate            DateTime @default(now())
  branch               Branch   @relation(fields: [branchId], references: [id])
  branchId             String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("audit_observations")
}

model SrmMessage {
  id        String   @id @default(uuid())
  name      String
  title     String
  region    String
  message   String
  highlight String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("srm_messages")
}

model DashboardTicker {
  id        String   @id @default(uuid())
  text      String
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dashboard_tickers")
}

model Atm {
  id          String   @id @default(uuid())
  atmId       String   @unique
  branch      Branch   @relation(fields: [branchId], references: [id])
  branchId    String
  lastTxnTime String
  balance     Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("atms")
}

model RegionalAsset {
  id                String              @id @default(uuid())
  assetCode         String              @unique
  category          String
  description       String
  purchaseDate      DateTime
  purchaseValue     Float
  condition         String              @default("GOOD")
  amcExpiry         DateTime?
  branch            Branch              @relation(fields: [branchId], references: [id])
  branchId          String
  maintenanceRecords MaintenanceRecord[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@map("regional_assets")
}

model MaintenanceRecord {
  id               String        @id @default(uuid())
  serviceDate      DateTime
  serviceProvider  String
  cost             Float
  remarks          String?
  nextServiceDue   DateTime
  asset            RegionalAsset @relation(fields: [assetId], references: [id])
  assetId          String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("maintenance_records")
}

model PostingHistory {
  id            String      @id @default(uuid())
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  branch        Branch      @relation(fields: [branchId], references: [id])
  branchId      String
  designation   Designation? @relation(fields: [designationId], references: [id])
  designationId String?
  startDate     DateTime    @default(now())
  endDate       DateTime?
  isCurrent     Boolean     @default(true)
  remarks       String?
  createdAt     DateTime    @default(now())

  @@map("posting_history")
}

model ChatGroup {
  id               String       @id @default(uuid())
  name             String
  type             String       @default("CUSTOM") // DEFAULT, CUSTOM, DISTRICT, POPULATION
  announcementMode Boolean      @default(false)
  createdBy        String?
  creator          User?        @relation(fields: [createdBy], references: [id])
  members          ChatMember[]
  messages         ChatMessage[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("chat_groups")
}

model ChatMember {
  id           String    @id @default(uuid())
  groupId      String
  group        ChatGroup @relation(fields: [groupId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  roleInGroup  String    @default("MEMBER") // GROUP_ADMIN, MEMBER
  isMuted      Boolean   @default(false)
  isSuspended  Boolean   @default(false)
  suspendedBy  String?
  updatedAt    DateTime  @updatedAt

  @@unique([groupId, userId])
  @@map("chat_group_members")
}

model ChatMessage {
  id               String       @id @default(uuid())
  type             String       @default("text") // text, mis_alert, mis_snapshot, ro_query, branch_response, system_info, emergency
  room             String       @default("global")
  user             String
  role             String       @default("BRANCH")
  branchCode       String?
  text             String
  payload          String?      // JSON stringified payload
  timestamp        DateTime     @default(now())
  readBy           String?      // Simple comma separated list (or JSON array) of usernames

  // Legacy relations kept for schema integrity, though not strictly required by new unified system
  groupId          String?
  group            ChatGroup?   @relation(fields: [groupId], references: [id])
  senderId         String?
  sender           User?        @relation(fields: [senderId], references: [id])
  
  acks             MessageAck[]

  @@map("chat_messages")
}

model BranchQuery {
  id           String      @id @default(uuid())
  branchCode   String
  queryText    String
  askedBy      String
  askedAt      DateTime    @default(now())
  deadline     DateTime?
  paramCodes   String?     // Stored as JSON string array
  status       String      @default("PENDING") // Enum mapped to string: PENDING, ANSWERED, ACKNOWLEDGED, ESCALATED
  response     String?
  respondedBy  String?
  respondedAt  DateTime?
  relatedMisDate DateTime?

  @@map("branch_queries")
}

model MessageAck {
  id               String      @id @default(uuid())
  messageId        String
  message          ChatMessage @relation(fields: [messageId], references: [id])
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  acknowledgedAt   DateTime    @default(now())
  correlationId    String?

  @@unique([messageId, userId])
  @@map("chat_message_acks")
}

model ChatAuditLog {
  id            String   @id @default(uuid())
  actorId       String
  actor         User     @relation(fields: [actorId], references: [id])
  action        String   // USER_SUSPENDED, GROUP_CREATED, ROLE_UPDATED, MSG_DELETED
  targetId      String?  // Id of the affected user/group/msg
  details       String?  // JSON string for metadata
  correlationId String?
  timestamp     DateTime @default(now())

  @@map("chat_audit_logs")
}

model IngestionLog {
  id        String   @id @default(uuid())
  unitId    String
  branch    Branch   @relation(fields: [unitId], references: [id])
  status    String   // PROCESSED, FAILED
  filename  String
  meta      Json?
  createdAt DateTime @default(now())
  facts     Fact[]
  
  importLogId String?
  importLog   MisImportLog? @relation(fields: [importLogId], references: [id], onDelete: Cascade)

  @@map("ingestion_logs")
}

model IngestionVerticalStatus {
  id              String   @id @default(uuid())
  businessDate    DateTime
  vertical        String   // CASA, TD, ADV, etc.
  status          String   // READY_FOR_MIS, PENDING
  isFreezeBlocker Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@unique([businessDate, vertical])
  @@map("ingestion_vertical_status")
}

model StgUnitFinancialsDaily {
  id           String   @id @default(uuid())
  unitCode     String
  businessDate DateTime
  sbBalance    Decimal? @db.Decimal(18, 2)
  cdBalance    Decimal? @db.Decimal(18, 2)
  tdBalance    Decimal? @db.Decimal(18, 2)
  advBalance   Decimal? @db.Decimal(18, 2)
  createdAt    DateTime @default(now())

  @@map("stg_unit_financials_daily")
}

model StgAccountDaily {
  id           String   @id @default(uuid())
  unitCode     String
  accountNo    String
  businessDate DateTime
  balance      Decimal? @db.Decimal(18, 2)
  sbBalance    Decimal? @db.Decimal(18, 2)
  cdBalance    Decimal? @db.Decimal(18, 2)
  tdBalance    Decimal? @db.Decimal(18, 2)
  advBalance   Decimal? @db.Decimal(18, 2)
  busBalance   Decimal? @db.Decimal(18, 2)
  casaBalance  Decimal? @db.Decimal(18, 2)
  createdAt    DateTime @default(now())

  @@map("stg_account_daily")
}

model StgUserVerticalDaily {
  id           String   @id @default(uuid())
  unitCode     String
  vertical     String
  outstanding  Decimal? @db.Decimal(18, 2)
  smaType      String?
  businessDate DateTime
  createdAt    DateTime @default(now())

  @@map("stg_user_vertical_daily")
}

model Fact {
  id          String       @id @default(uuid())
  unitId      String
  branch      Branch       @relation(fields: [unitId], references: [id])
  date        DateTime
  metric      String
  value       Decimal      @db.Decimal(18, 2)
  ingestionId String?
  ingestion   IngestionLog? @relation(fields: [ingestionId], references: [id])
  createdAt   DateTime     @default(now())

  @@index([date, unitId, metric])
  @@map("mis_facts")
}

model MisSnapshot {
  id           String                @id @default(uuid())
  unitId       String
  branch       Branch                @relation(fields: [unitId], references: [id])
  businessDate DateTime
  status       String                // PROVISIONAL, FINAL
  version      Int                   @default(1)
  frozenAt     DateTime?
  panelData    MisInformationPanel[]
  exceptions   MisException[]
  createdAt    DateTime              @default(now())

  @@unique([unitId, businessDate, version])
  @@map("mis_snapshots")
}

model MisInformationPanel {
  id             String      @id @default(uuid())
  snapshotId     String
  snapshot       MisSnapshot @relation(fields: [snapshotId], references: [id])
  parameter      String
  val_prev_fy_start Decimal     @default(0) @db.Decimal(18, 2)
  val_prev_fy_end   Decimal     @default(0) @db.Decimal(18, 2)
  val_fy_start      Decimal     @default(0) @db.Decimal(18, 2)
  val_fy_end        Decimal     @default(0) @db.Decimal(18, 2)
  val_prev_m_end    Decimal     @default(0) @db.Decimal(18, 2)
  val_dby           Decimal     @default(0) @db.Decimal(18, 2)
  val_y_eod         Decimal     @default(0) @db.Decimal(18, 2)
  val_current       Decimal     @default(0) @db.Decimal(18, 2)
  growth_prev_fy    Decimal     @default(0) @db.Decimal(18, 2)
  growth_day        Decimal     @default(0) @db.Decimal(18, 2)
  growth_month      Decimal     @default(0) @db.Decimal(18, 2)
  growth_fy         Decimal     @default(0) @db.Decimal(18, 2)
  budget_month      Decimal     @default(0) @db.Decimal(18, 2)
  gap_month         Decimal     @default(0) @db.Decimal(18, 2)
  budget_quarter    Decimal     @default(0) @db.Decimal(18, 2)
  gap_quarter       Decimal     @default(0) @db.Decimal(18, 2)
  status            String      @default("Neutral") // Surpassed, Positive, Negative, Neutral

  @@map("mis_information_panels")
}

model MisException {
  id           String      @id @default(uuid())
  snapshotId   String
  snapshot     MisSnapshot @relation(fields: [snapshotId], references: [id])
  unitId       String
  branch       Branch      @relation(fields: [unitId], references: [id])
  businessDate DateTime
  type         String      // BUDGET_CONTROL, GROWTH, RISK, LIQUIDITY
  severity     String      // LOW, MEDIUM, HIGH, CRITICAL
  parameter    String
  message      String
  triggerValue String?
  ruleId       String?
  status       String      @default("OPEN") // OPEN, ACKNOWLEDGED, RESOLVED
  taskId       String?
  createdAt    DateTime    @default(now())

  @@map("mis_exceptions")
}


model AccountOpening {
  id              String   @id @default(uuid())
  solId           String   // Branch code
  branch          Branch   @relation(fields: [solId], references: [code])
  cifId           String
  foracid         String   @unique // Account Number
  acctName        String
  schmType        String
  schmCode        String
  accountClass    String?  // SB, CD standardized
  acctOpnDate     DateTime
  clrBalAmt       Decimal  @db.Decimal(18, 2)
  averageBalance  Decimal  @db.Decimal(18, 2)
  businessDate    DateTime // The date this data was uploaded for
  
  isQualified     Boolean  @default(false)
  rejectionReason String?
  dataQualityFlag String   @default("VALID")
  
  // Customer Intelligence
  customerValueScore Float?
  valueRank          Int?
  valueBucket        String? // HIGH_VALUE, PREMIUM, RETAIL
  
  createdAt       DateTime @default(now())

  @@index([businessDate])
  @@index([solId])
  @@map("account_openings")
}

model AccountClosure {
  id              String   @id @default(uuid())
  solId           String   // Branch code
  branch          Branch   @relation(fields: [solId], references: [code])
  cifId           String
  foracid         String   @unique // Account Number
  acctName        String
  schmType        String
  schmCode        String
  accountClass    String?  // SB, CD standardized
  acctOpnDate     DateTime
  acctClsDate     DateTime
  balanceAtCls    Decimal  @db.Decimal(18, 2)
  businessDate    DateTime // The date this data was uploaded for
  
  dataQualityFlag String   @default("VALID")
  createdAt       DateTime @default(now())

  @@index([businessDate])
  @@index([solId])
  @@map("account_closures")
}

model CalendarMaster {
  calDate         DateTime @id
  isWorkingDay    Boolean  @default(true)
  holidayFlag     Boolean  @default(false)
  monthKey        String   // e.g., "2026-02"
  financialPeriod String?  // e.g., "Q4-2025-26"

  @@map("calendar_master")
}

model FactSbDailyBranch {
  id              String   @id @default(uuid())
  solId           String
  openDay         DateTime
  netSbOpened     Int
  sbClosed        Int      @default(0)
  workingDayFlag  Boolean
  qualifiedCount  Int
  dataQualityFlag String
  createdAt       DateTime @default(now())

  @@unique([solId, openDay])
  @@map("fact_sb_daily_branch")
}

model FactCdMonthlyBranch {
  id              String   @id @default(uuid())
  solId           String
  monthKey        String
  netCdOpened     Int
  cdClosed        Int      @default(0)
  qualifiedCount  Int
  dataQualityFlag String
  createdAt       DateTime @default(now())

  @@unique([solId, monthKey])
  @@map("fact_cd_monthly_branch")
}

model ProductAdoptionScheme {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  type      String   // SB, CD
  isActive  Boolean  @default(true)

  @@map("product_adoption_schemes")
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique // e.g., "MIN_OPENING_BALANCE"
  value     String
  dataType  String   @default("STRING") // STRING, NUMBER, BOOLEAN
  group     String   @default("GENERAL") // PLANNING, HR, etc.
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   @default("INFO") // INFO, ALERT, SUCCESS, ERROR
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@map("notifications")
}

model BudgetMaster {
  id            String   @id @default(uuid())
  parameterName String
  solId         String
  branch        Branch   @relation(fields: [solId], references: [code])
  periodKey     String
  effectiveDate DateTime?
  targetValue   Decimal  @db.Decimal(18, 2)
  versionNo     Int      @default(1)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sourceBatchId String

  @@unique([parameterName, solId, periodKey])
  @@map("budget_master")
}

model BudgetHistory {
  id            String   @id @default(uuid())
  parameterName String
  solId         String
  periodKey     String
  effectiveDate DateTime?
  targetValue   Decimal  @db.Decimal(18, 2)
  versionNo     Int
  sourceBatchId String
  changeType    String   // INSERT, UPDATE, DELETE
  changedAt     DateTime @default(now())

  @@map("budget_history")
}

model MisParameterRegistry {
  parameterName          String  @id
  displayName            String
  fullForm               String? 
  description            String?
  category               String?
  isEnabled              Boolean @default(true)
  createdFromBudgetFlag  Boolean @default(true)
  orderIndex             Int     @default(0)

  // Hierarchy
  parentParameterName    String?
  parentParameter        MisParameterRegistry?  @relation("ParameterHierarchy", fields: [parentParameterName], references: [parameterName])
  childParameters        MisParameterRegistry[] @relation("ParameterHierarchy")

  @@map("mis_parameter_registry")
}

model BudgetImportLog {
  id         String   @id @default(uuid())
  filename   String
  checksum   String
  status     String   @default("PROCESSING") // PROCESSING, SUCCESS, FAILED
  uploaderId String?
  totalRows  Int
  validRows  Int
  errorRows  Int
  createdAt  DateTime @default(now())

  @@map("budget_import_logs")
}


model MisImportLog {
  id            String   @id @default(uuid())
  filename      String
  status        String   @default("SUCCESS") // SUCCESS, FAILED
  processedUnits Int
  failedUnits    Int
  uniqueDates    String[] // Array of business dates found in file
  createdAt     DateTime @default(now())
  
  ingestionLogs IngestionLog[]

  @@map("mis_import_logs")
}
