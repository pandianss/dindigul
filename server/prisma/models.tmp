
model Campaign {
  id          String   @id @default(uuid())
  titleEn     String
  description String?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  targets     CampaignTarget[]
  performances CampaignPerformance[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("campaigns")
}

model CampaignTarget {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  parameterId String
  parameter   Parameter @relation(fields: [parameterId], references: [id])
  targetValue Float

  @@map("campaign_targets")
}

model CampaignPerformance {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  currentValue Float
  asOfDate    DateTime

  @@map("campaign_performances")
}

model PeriodicReturn {
  id          String   @id @default(uuid())
  titleEn     String
  frequency   String   // DAILY, WEEKLY, MONTHLY, QUARTERLY
  dueDate     DateTime
  status      String   @default("PENDING") // PENDING, SUBMITTED, DELAYED, VERIFIED
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  submittedAt DateTime?
  verifiedAt  DateTime?
  period      String?  // e.g., "Aug 2025"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("periodic_returns")
}

model Claim {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  type        String   // CONVEYANCE, MEDICAL, ENTERTAINMENT, ETC.
  amount      Float
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, PAID
  notes       String?
  attachments String?  // File paths
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("claims")
}

model Achievement {
  id          String   @id @default(uuid())
  titleEn     String
  description String?
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  date        DateTime
  imageUrl    String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("achievements")
}
