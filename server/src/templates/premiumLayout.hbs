<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <style>
        @page { margin: 0; }
        
        {{#if organization.tamilFont}}
        @font-face {
            font-family: 'ArimaTamil';
            src: url(data:font/ttf;base64,{{organization.tamilFont}}) format('truetype');
            font-weight: normal;
            font-style: normal;
        }
        {{/if}}

        {{#if organization.hindiFont}}
        @font-face {
            font-family: 'NotoHindi';
            src: url(data:font/ttf;base64,{{organization.hindiFont}}) format('truetype');
            font-weight: normal;
            font-style: normal;
        }
        {{/if}}

        body { 
            font-family: 'Century Gothic', 'Segoe UI', Tahoma, sans-serif; 
            line-height: 1.4; 
            color: #1a1a1a; 
            margin: 0;
            padding: 0;
            font-size: 14px;
        }
        
        /* Apply Trilingual Fonts */
        .tamil-text, .bank-name-ta, .tamil-col, .signatory-ta {
            font-family: 'ArimaTamil', 'Century Gothic', sans-serif !important;
        }
        .hindi-text, .bank-name-hi, .hindi-col, .signatory-hi {
            font-family: 'NotoHindi', 'Segoe UI', sans-serif !important;
        }

        .page-container {
            padding: 30px 50px;
            position: relative;
            min-height: 100vh;
            box-sizing: border-box;
        }
        
        /* Horizontal Header Layout - Left Aligned */
        .header {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 20px;
            margin-bottom: 12px;
        }
        .logo-container {
            flex-shrink: 0;
        }
        .logo-img {
            height: 60px;
            width: auto;
        }
        .bank-names-container {
            text-align: left;
        }
        
        /* Trilingual Bank Name Styles - Refined Spacing & Weight */
        .bank-name-ta { color: #00338d; font-size: 19px; font-weight: 900; margin: 0; line-height: 1.3; }
        .bank-name-hi { color: #00338d; font-size: 19px; font-weight: 700; margin: 0; line-height: 1.3; }
        .bank-name-en { 
            color: #00338d; 
            font-size: 18px; 
            font-weight: 700; 
            margin: 0; 
            text-transform: uppercase; 
            letter-spacing: 0.1px; 
            font-family: Arial, Helvetica, sans-serif; 
            line-height: 1.3; 
        }        
        /* 3-Column Info Section */
        .info-section {
            display: flex;
            justify-content: space-between;
            align-items: stretch; /* Ensures all columns have the same height */
            margin-top: 15px;
            padding: 10px 0;
            /* border-top removed for clean look */
        }
        .info-col {
            flex: 1;
            padding: 0 5px;
            font-size: 10px;
            color: #444;
            border-right: 1px solid #ddd;
            text-align: center;
            overflow-wrap: break-word;
        }
        .info-col:last-child {
            border-right: none;
        }
        .tamil-col {
            font-size: 6.5pt;
            flex: 1; /* Match other columns for alignment */
        }
        .office-label {
            font-weight: 800;
            display: block;
            margin-bottom: 4px;
            color: #1a1a1a;
            font-size: 10.5px;
        }
        .tamil-col .office-label {
            font-size: 7.5pt;
            font-weight: 900; /* Maximum boldness for small title */
        }
        .tamil-col .address-text {
            line-height: 1.2;
        }
        .address-text {
            line-height: 1.3;
        }

        /* Contact Section */
        .contact-section {
            background: #eef4ff; /* Pale blue box */
            padding: 7px 0;
            font-size: 10px;
            color: #444;
            display: flex;
            justify-content: center;
            gap: 25px;
            margin-bottom: 20px;
            border-radius: 2px;
        }

        .meta-strip {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 25px;
            color: #222;
            padding-bottom: 4px;
        }

        .content { 
            min-height: 520px; 
            position: relative;
            z-index: 1;
        }
        
        .doc-title {
            text-align: center;
            margin-bottom: 25px;
        }
        .doc-title h2, .main-title { 
            font-size: 16px; 
            color: #00338d; 
            text-decoration: none;
            text-transform: uppercase;
            margin: 0;
            letter-spacing: 0.5px;
            font-weight: 800;
        }
        .doc-subtitle {
            font-size: 12px;
            color: #444;
            margin-top: 4px;
            font-weight: 700;
        }
        .meta-header {
            font-size: 9px;
            color: #666;
            margin-top: 3px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.1px;
        }

        .letter-body {
            font-size: 14.5px;
            text-align: justify;
        }

        .footer { 
            margin-top: 50px; 
            padding-top: 15px;
        }
        
        .signatories-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            margin-top: 20px;
        }
        
        .signatory-col {
            flex: 1;
            text-align: center;
            min-width: 0;
        }
        
        .signature-space {
            height: 60px;
        }
        
        .sig-name {
            font-weight: 800;
            font-size: 13px;
            color: #1a1a1a;
            margin-bottom: 2px;
        }
        
        .sig-title {
            font-size: 11px;
            color: #444;
            line-height: 1.2;
        }
        
        .sig-ta { font-family: 'ArimaTamil', sans-serif !important; font-size: 11.5px; font-weight: 900; }
        .sig-hi { font-family: 'NotoHindi', sans-serif !important; font-size: 11.5px; }
        .sig-en { font-size: 11px; text-transform: uppercase; font-weight: 700; }
        
        .page-footer {
            position: absolute;
            bottom: 15px;
            left: 50px;
            right: 50px;
            font-size: 9px;
            color: #aaa;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="page-container">
        <!-- Centered Header with Logo -->
        <div class="header">
            <div class="logo-container">
                {{#if organization.bankLogo}}
                <img src="{{organization.bankLogo}}" class="logo-img" alt="IOB Logo">
                {{/if}}
            </div>
            <div class="bank-names-container">
                <div class="bank-name-ta">{{organization.bankNameTa}}</div>
                <div class="bank-name-hi">{{organization.bankNameHi}}</div>
                <div class="bank-name-en">{{organization.bankNameEn}}</div>
            </div>
        </div>

        <!-- 3-Column Info Row -->
        <div class="info-section">
            <div class="info-col tamil-col">
                <span class="office-label">{{organization.officeNameTa}}</span>
                <div class="address-text">{{{organization.addressTaFormatted}}}</div>
            </div>
            <div class="info-col hindi-col">
                <span class="office-label">{{organization.officeNameHi}}</span>
                <div class="address-text">{{{organization.addressHiFormatted}}}</div>
            </div>
            <div class="info-col">
                <span class="office-label">{{organization.officeNameEn}}</span>
                <div class="address-text">{{{organization.addressEnFormatted}}}</div>
            </div>
        </div>

        <!-- Contact Row -->
        <div class="contact-section">
            <span><strong>Phone:</strong> {{organization.phone}}</span>
            <span><strong>Email:</strong> {{organization.email}}</span>
            <span><strong>Web:</strong> {{organization.website}}</span>
        </div>

        <!-- Meta Strip -->
        <div class="meta-strip">
            <span>Ref No: {{refNo}}</span>
            <span>Date: {{date}}</span>
        </div>

        <div class="content">
            <div class="doc-title">
                <h2 class="main-title">
                    {{#if titleTa}}<span class="tamil-text">{{titleTa}}</span> / {{/if}}
                    {{#if titleHi}}<span>{{titleHi}}</span> / {{/if}}
                    <span>{{title}}</span>
                </h2>
                {{#if subTitle}}
                <div class="doc-subtitle">
                    {{#if subTitleTa}}<span class="tamil-text">{{subTitleTa}}</span> / {{/if}}
                    {{#if subTitleHi}}<span>{{subTitleHi}}</span> / {{/if}}
                    <span>{{subTitle}}</span>
                </div>
                {{/if}}
                {{#if metaHeader}}
                <div class="meta-header">{{metaHeader}}</div>
                {{/if}}
            </div>

            <div class="letter-body">
                {{{bodyHtml}}}
            </div>
        </div>

        <!-- Footer / Signatories -->
        <div class="footer">
            {{#if initiator}}
            <!-- Row 1: Initiator -->
            <div class="signatory-row initiator-row">
                <div class="signatory-col" style="text-align: left;">
                    <div class="signature-space"></div>
                    {{#if initiator.nameTa}}<div class="sig-name sig-ta">{{initiator.nameTa}}</div>{{/if}}
                    {{#if initiator.nameHi}}<div class="sig-name sig-hi">{{initiator.nameHi}}</div>{{/if}}
                    <div class="sig-name sig-en">{{initiator.nameEn}}</div>
                    {{#if initiator.titleTa}}<div class="sig-title sig-ta">{{initiator.titleTa}}</div>{{/if}}
                    {{#if initiator.titleHi}}<div class="sig-title sig-hi">{{initiator.titleHi}}</div>{{/if}}
                    <div class="sig-title sig-en">{{initiator.titleEn}}</div>
                </div>
            </div>
            {{/if}}

            {{#if reviewersOrApprovers}}
            <!-- Row 2: Reviewers & Approvers -->
            <div class="signatories-row">
                {{#each reviewersOrApprovers}}
                <div class="signatory-col">
                    <div class="signature-space"></div>
                    {{#if nameTa}}<div class="sig-name sig-ta">{{nameTa}}</div>{{/if}}
                    {{#if nameHi}}<div class="sig-name sig-hi">{{nameHi}}</div>{{/if}}
                    <div class="sig-name sig-en">{{nameEn}}</div>
                    {{#if titleTa}}<div class="sig-title sig-ta">{{titleTa}}</div>{{/if}}
                    {{#if titleHi}}<div class="sig-title sig-hi">{{titleHi}}</div>{{/if}}
                    <div class="sig-title sig-en">{{titleEn}}</div>
                </div>
                {{/each}}
            </div>
            {{/if}}

            <div class="seal-container" style="margin-top: 30px;">
                {{#if deptSealSrc}}
                    <img src="{{deptSealSrc}}" class="seal-img" style="max-height: 80px; opacity: 0.8;" alt="Seal">
                {{/if}}
            </div>
        </div>

        <div class="page-footer">
            Generated by Dindigul Banking Portal | Confidential
        </div>
    </div>
</body>
</html>
