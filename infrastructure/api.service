[Unit]
Description=Dindigul Bank Portal API
After=network.target postgresql.service

[Service]
Type=simple
User=nodeuser
WorkingDirectory=/var/www/dindigul/server
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
Environment=NODE_ENV=production
Environment=PORT=5000
# Add other environment variables as needed or use EnvironmentFile

[Install]
WantedBy=multi-user.target
